#include <iostream>
#include <vector>
#include <algorithm>
#include <numeric>
using namespace std;

bool perm(vector<int> &vec){
    int i;
    for(i = vec.size() - 2; i >= 0; i--){
        if(vec[i] < vec[i + 1]){
            break;
        }
    }
    
    if(i == -1){return false;}
    
    int j;
    for(j = vec.size() - 1; vec[j] <= vec[i];j --);
    
    swap(vec[i], vec[j]);
    
    reverse(vec.begin() + 1 + i,vec.end());
    
    return true;
}

int f(int n){
    int p = 1;
    for(int i = 2;i <= n;i++){
        p *= i;
    }
    return p;
}

vector<long long> fact(13);

void perm_calc(vector<int> &vec, int n,int k){
    while(n > 0){
        int i = 0;
        for(i = 12; i > 0;i--){
            if(fact[i] < k){
                break;    
            }
        }
        
        
        
        swap(vec[n - i - 1], vec[k / fact[i] + i - 1] );
        
        for(auto i : vec){cout << i << " ";}
        cout << '\n';
        
        k %= fact[i];
        
        sort(vec.begin() + n - i,vec.end());
    }
}

int main()
{
    for(int i = 1;i <= 12;i++){
        fact[i] = f(i);
    }
    
    int n,k;
    cin >> n >> k;
    vector<int> vec (n, 0);
    iota(vec.begin(),vec.end(),1);
    
    perm_calc(vec,n,k - 1);
    
    for(int i : vec){
        cout << i << ' ';
    }
    
        
  
    
    return 0;
}
